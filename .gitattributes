# normalise line endings so Windows and Linux contributors produce identical diffs
* text=auto eol=lf
*.ps1 text eol=crlf
*.sh text eol=lf

# binaries
*.mp4 binary
*.webp binary
*.jpg binary
*.png binary
*.woff2 binary
*.wav binary
*.zip binary

# keep the vendored fonts out of language statistics
skills/pure-code-video/templates/fonts/* linguist-vendored
docs/assets/* linguist-documentation
